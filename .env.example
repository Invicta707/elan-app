# Elan ortam değişkenleri şablonu.
# Yerelde: bu dosyayı .env.local olarak kopyalayıp doldur.
# Vercel'de: Project → Settings → Environment Variables (Production ve Preview).
#
# NEXT_PUBLIC_ ile başlayanlar build sırasında tarayıcı paketine gömülür:
#   - İlk deploy'dan ÖNCE tanımlı olmalı (Supabase değişkenleri yoksa build düşer).
#   - Değiştirilince yeniden deploy gerekir.
# Önekli olmayanlar sadece sunucuda okunur; tarayıcıya asla gitmez.

# ---------------------------------------------------------------
# Supabase (Project Settings → API)
# ---------------------------------------------------------------

# Zorunlu
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co

# Zorunlu: ikisinden biri. Yeni anahtar formatı (sb_publishable_...) önceliklidir.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Zorunlu (sunucu): ikisinden biri. RLS'i atlar; video yükleme ve Cloudflare
# webhook'u kullanır. ASLA NEXT_PUBLIC_ önekiyle tanımlama.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Site
# ---------------------------------------------------------------

# Özel alan adında zorunlu: canonical ve OpenGraph (WhatsApp/sosyal medya kartı)
# linkleri buna göre tamamlanır. Boş, tanımsız ya da bozuksa build düşmez:
# Vercel'de projenin alan adı (önizlemede o deploy'un adresi), Vercel dışında
# https://gozuyle.com kullanılır (bkz. lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=https://<alan-adın>

# Gizlilik politikası, kullanım koşulları ve hesap sayfasındaki destek adresi
# (KVKK başvuruları, hesap silme talepleri). Boş ya da geçersizse
# destek@gozuyle.com kullanılır (bkz. lib/legal.ts).
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------
# Cloudflare Stream (sunucu)
# ---------------------------------------------------------------

# Zorunlu: Cloudflare panelinde sağ üst / Account ID
CLOUDFLARE_ACCOUNT_ID=

# Zorunlu: "Stream: Edit" yetkili API token'ı
CLOUDFLARE_API_TOKEN=

# Canlıda zorunlu: webhook imzası. Webhook canlı adrese kaydedilince dönen
# "secret" değeri (bkz. app/api/webhooks/cloudflare/route.ts). Yoksa videolar
# işlense de ilanlar yayına geçmez. Yerelde gerekmez: orada
# /api/dev/complete-upload aynı işi yapar.
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
