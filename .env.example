# Elan ortam değişkenleri şablonu.
# Yerelde: bu dosyayı .env.local olarak kopyalayıp doldur.
# Vercel'de: Project → Settings → Environment Variables (Production ve Preview).
#
# NEXT_PUBLIC_ ile başlayanlar build sırasında tarayıcı paketine gömülür:
#   - İlk deploy'dan ÖNCE tanımlı olmalı (Supabase değişkenleri yoksa build düşer).
#   - Değiştirilince yeniden deploy gerekir.
# Önekli olmayanlar sadece sunucuda okunur; tarayıcıya asla gitmez.

# ---------------------------------------------------------------
# Supabase (Project Settings → API)
# ---------------------------------------------------------------

# Zorunlu
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co

# Zorunlu: ikisinden biri. Yeni anahtar formatı (sb_publishable_...) önceliklidir.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Zorunlu (sunucu): ikisinden biri. RLS'i atlar; video yükleme ve Cloudflare
# webhook'u kullanır. ASLA NEXT_PUBLIC_ önekiyle tanımlama.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Site
# ---------------------------------------------------------------

# Özel alan adında zorunlu: canonical ve OpenGraph (WhatsApp/sosyal medya kartı)
# linkleri buna göre tamamlanır. Boş, tanımsız ya da bozuksa build düşmez:
# Vercel'de projenin alan adı (önizlemede o deploy'un adresi), Vercel dışında
# https://gozuyle.com kullanılır (bkz. lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=https://<alan-adın>

# Gizlilik politikası, kullanım koşulları ve hesap sayfasındaki destek adresi
# (KVKK başvuruları, hesap silme talepleri). Boş ya da geçersizse
# destek@gozuyle.com kullanılır (bkz. lib/legal.ts).
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------
# Cloudflare Stream (sunucu)
# ---------------------------------------------------------------

# Zorunlu: Cloudflare panelinde sağ üst / Account ID
CLOUDFLARE_ACCOUNT_ID=

# Zorunlu: "Stream: Edit" yetkili API token'ı
CLOUDFLARE_API_TOKEN=

# Canlıda zorunlu: webhook imzası. Webhook canlı adrese kaydedilince dönen
# "secret" değeri (bkz. app/api/webhooks/cloudflare/route.ts). Yoksa videolar
# işlense de ilanlar yayına geçmez. Yerelde gerekmez: orada
# /api/dev/complete-upload aynı işi yapar.
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Moderasyon (sunucu)
# ---------------------------------------------------------------

# /admin/reports paneline erişebilecek hesapların e-postaları, virgülle ayrılmış
# (örnek: ali@ornek.com,ayse@ornek.com). Hesabın e-postası onaylı olmalı.
# Boşsa panel kimseye açılmaz. Değiştirince yeniden deploy gerekir.
ADMIN_EMAILS=

# ---------------------------------------------------------------
# Otomatik içerik denetimi (sunucu)
# ---------------------------------------------------------------
#
# Yeni ilanın videosu işlenince ilan yayına değil içerik denetimine girer:
# video kareleri (kapak + 5 ara kare), fotoğraflar ve açıklama denetlenir.
#   Cinsel içerik / çıplaklık ya da şiddet / kan / silah > %60 → otomatik ret,
#   video ve fotoğraflar silinir; %40–60 → /admin/reports'ta insan onayı.
# Profil fotoğrafları da yüklenirken denetlenir. Kurallar: lib/content-moderation.ts
#
# Görsel sağlayıcı TANIMLI DEĞİLSE denetim "yapılamadı" sayılır: yeni ilanlar
# yayına girmez, yönetim panelinde elle onay bekler; profil fotoğrafı yüklenemez.
# Değiştirince yeniden deploy gerekir.

# Görsel sağlayıcı: sightengine | rekognition | openai | none.
# Boşsa anahtarı tanımlı ilk sağlayıcı (bu sırayla) kullanılır.
MODERATION_IMAGE_PROVIDER=

# Sightengine (sightengine.com → API keys). Modeller: nudity-2.1, weapon, violence, gore-2.0
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# AWS Rekognition (DetectModerationLabels yetkili IAM kullanıcısı). AWS_* adları
# Vercel'de ayrılmış olduğu için REKOGNITION_* kullanılıyor. Görsel en fazla 5 MB.
REKOGNITION_ACCESS_KEY_ID=
REKOGNITION_SECRET_ACCESS_KEY=
REKOGNITION_REGION=eu-central-1

# OpenAI Moderation (ücretsiz uç). Tanımlıysa ilan açıklamaları ve mesajlar
# anlamına göre (taciz, tehdit, nefret, cinsel içerik) denetlenir; görsel
# sağlayıcı olarak da seçilebilir (silah kategorisi yok).
# MODERATION_TEXT_PROVIDER=none metin denetimini kapatır (temel kelime filtresi her zaman açık).
OPENAI_API_KEY=
# OPENAI_MODERATION_MODEL=omni-moderation-latest
